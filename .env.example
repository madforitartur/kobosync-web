# ── Firebase (Firestore) — só metadados, nunca ficheiros ────────────────────
FIREBASE_PROJECT_ID=o-teu-projeto-firebase
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@o-teu-projeto-firebase.iam.gserviceaccount.com
# Cola a private_key do JSON da conta de serviço tal e qual (com \n literais)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# ── Google Drive — CONTA 1: onde estão os EPUBs (biblioteca) ───────────────
GOOGLE_CLIENT_EMAIL=drive-livros@projeto-a.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# ID da pasta raiz da biblioteca (opcional — sem isto pesquisa toda a Drive)
GOOGLE_DRIVE_FOLDER_ID=
# Só se a biblioteca estiver numa Shared Drive
GOOGLE_SHARED_DRIVE_ID=

# ── Google Drive — CONTA 2: onde ficam as capas (pode ser outra conta) ─────
# Se deixares estas 3 variáveis vazias, as capas usam a CONTA 1 acima.
GOOGLE_COVERS_CLIENT_EMAIL=drive-capas@projeto-b.iam.gserviceaccount.com
GOOGLE_COVERS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# ID da pasta (na conta 2) onde as capas vão ser guardadas — OBRIGATÓRIO
# se quiseres mesmo usar uma conta separada para as capas.
GOOGLE_COVERS_FOLDER_ID=
GOOGLE_COVERS_SHARED_DRIVE_ID=

# ── Outras ───────────────────────────────────────────────────────────────
# URL pública da app em produção (usado pelo sync de capas em background)
NEXT_PUBLIC_BASE_URL=https://o-teu-dominio.vercel.app
